# Unity
Library/
Temp/
Obj/
Logs/
UserSettings/
Build/
Builds/
# Builds/PublisherPrivate/ holds the launcher signing key: never commit it (covered by Builds/ above, listed for clarity)
Builds/PublisherPrivate/
*.csproj
*.sln
*.slnx
.vs/
__pycache__/
# Unity crash-recovery scenes
Assets/_Recovery/
Assets/_Recovery.meta
# Per-machine check output and scratch
local/

# Fix 3.1: Meshy raw FBX duplicates the GLB; Blender backups
SourceArt/Meshy/*/model.fbx
*.blend1
SourceArt/Meshy/*/*.blend

# Round 4: Suno soundtrack ships through the launcher soundtrack component, not git
BundleMusic/

# Round 8: big Blender sources are made again by their scripts (ship.py, mothership.py); backups never
SourceArt/Blender/Ship.blend
SourceArt/Blender/Mothership.blend
*.blend1
